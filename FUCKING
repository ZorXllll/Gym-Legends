-- Variables for Loop Teleport and Fast Punch
local combinedActive = false
local targetPosition = Vector3.new(14.51, 4.59, 2099.40)
local FastPunchConnection = nil

-- Handle Loop Teleport & Fast Punch inside a single Heartbeat connection for efficiency
game:GetService("RunService").Heartbeat:Connect(function()
    if combinedActive then
        local localPlayer = game.Players.LocalPlayer
        
        -- 1. Execute Teleport
        if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
            localPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(targetPosition)
        end
        
        -- 2. Execute Fast Punch logic per frame
        _G.punchanim = true
        local Character = localPlayer.Character
        if Character then
            local Humanoid = Character:FindFirstChildOfClass('Humanoid')
            local PunchTool = localPlayer.Backpack:FindFirstChild('Punch') or Character:FindFirstChild('Punch')
            
            if PunchTool then
                local attackTime = PunchTool:FindFirstChild('attackTime')
                if attackTime then 
                    attackTime.Value = 0 
                end
                
                -- Auto equip if tool is in backpack
                if Humanoid and PunchTool.Parent ~= Character then 
                    Humanoid:EquipTool(PunchTool) 
                end
                
                PunchTool:Activate()
            end
        end
    end
end)

