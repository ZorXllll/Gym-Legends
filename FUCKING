end

-- [[ ULTRA-RELIABLE KARMA CHECKER ]]
local function checkTargetKarma(targetPlayer, karmaType)
    if not targetPlayer then return false end
    
    -- Check leaderstats variants
    local stats = targetPlayer:FindFirstChild("leaderstats")
    if stats then
        for _, v in ipairs(stats:GetChildren()) do
            if v.Name:lower():gsub("%s+", "") == karmaType:lower():gsub("%s+", "") then
                if v:IsA("ValueBase") and v.Value > 0 then
                    return true
                end
            end
        end
    end
    
    -- Check direct player folders / attributes
    for _, v in ipairs(targetPlayer:GetChildren()) do
        if v:IsA("ValueBase") and v.Name:lower():gsub("%s+", "") == karmaType:lower():gsub("%s+", "") and v.Value > 0 then
            return true
        end
        if v:IsA("Folder") or v:IsA("Configuration") then
            for _, subV in ipairs(v:GetChildren()) do
                if subV:IsA("ValueBase") and subV.Name:lower():gsub("%s+", "") == karmaType:lower():gsub("%s+", "") and subV.Value > 0 then
                    return true
                end
            end
        end
    end
    
    return false
end

