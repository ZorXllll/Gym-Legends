-- Add the Fast Auto Lit Switch using Elerium syntax
features:AddSwitch("Fast Auto Lift", function(Value)
    _G.FastTools = Value
    
    local LocalPlayer = game:GetService("Players").LocalPlayer
    
    -- Function to apply values (0 if enabled, original value if disabled)
    local function applySettings(isFast)
        local character = LocalPlayer.Character
        local backpack = LocalPlayer.Backpack
        
        for _, toolInfo in ipairs(toolSettings) do
            local toolName = toolInfo[1]
            local propName = toolInfo[2]
            local normalVal = toolInfo[3]
            local targetVal = isFast and 0 or normalVal
            
            for _, container in ipairs({backpack, character}) do
                if container then
                    local tool = container:FindFirstChild(toolName)
                    if tool then
                        local prop = tool:FindFirstChild(propName)
                        if prop then
                            prop.Value = targetVal
                        end
                    end
                end
            end
        end
    end

    if not Value then
        applySettings(false)
        return
    end
    
    -- Apply fast values immediately when turned on
    applySettings(true)
    
    -- Safe background loop for tool activation
    task.spawn(function()
        while _G.FastTools do
            task.wait(0.01) -- Safe delay to avoid game lag/crashes
            if not _G.FastTools then break end
            
            local character = LocalPlayer.Character
            if character then
                for _, toolInfo in ipairs(toolSettings) do
                    local toolName = toolInfo[1]
                    local equippedTool = character:FindFirstChild(toolName)
                    if equippedTool then
                        equippedTool:Activate()
                    end
                end
            end
        end
    end)
end)

