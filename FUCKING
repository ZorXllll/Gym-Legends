local targetPos = Vector3.new(0, -1000, 0) -- Target position sa void
local lastPos = Vector3.new(0, 0, 0)
local toggle = false
local velConn = nil

-- Helper Functions
local function getHRP()
    local char = localPlayer.Character
    if char then
        return char:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

local function resetCameraSubject()
    if workspace.CurrentCamera and localPlayer.Character then
        local humanoid = localPlayer.Character:FindFirstChildWhichIsA("Humanoid")
        if humanoid then
            workspace.CurrentCamera.CameraSubject = humanoid
        end
    end
end

-- Function para gumawa o i-maintain ang Gaze part at Camera Subject
local function ensureGazePart(fallbackPos)
    local gaze = workspace:FindFirstChild("Gaze")
    if not gaze then
        gaze = Instance.new("Part")
        gaze.Size = Vector3.new(4, 1, 4)
        gaze.Position = fallbackPos or lastPos
        gaze.Anchored = true
        gaze.CanCollide = false
        gaze.Transparency = 0.5
        gaze.Name = "Gaze"
        gaze.Parent = workspace
    end
    
    if workspace.CurrentCamera and workspace.CurrentCamera.CameraSubject ~= gaze then
        workspace.CurrentCamera.CameraSubject = gaze
    end
    return gaze
end

local function createTween(targetCFrame)
    local hrp = getHRP()
    if not hrp then return end
    local tweenInfo = TweenInfo.new(TeleportTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    return TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
end

local function startVelLoop()
    if velConn then velConn:Disconnect() end
    velConn = RunService.Heartbeat:Connect(function()
        if toggle then
            workspace.FallenPartsDestroyHeight = 0/0
            ensureGazePart(lastPos)
            
            local char = localPlayer.Character
            local hrp = getHRP()
            
            if char then
                for _, part in pairs(char:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
            
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end
    end)
end

local function stopVelLoop()
    if velConn then
        velConn:Disconnect()
        velConn = nil
    end
end

-- Toggle Feature sa Elerium v2
local switch = features:AddSwitch("Safe Spot", function(bool)
    toggle = bool
    
    local hrp = getHRP()
    if not hrp then 
        toggle = false
        return 
    end

    if toggle then
        lastPos = hrp.Position
        ensureGazePart(lastPos)
        
        task.wait()
        workspace.FallenPartsDestroyHeight = 0/0 
        local tweenToTarget = createTween(CFrame.new(targetPos))
        if tweenToTarget then
            tweenToTarget:Play()
            tweenToTarget.Completed:Wait()
        end
        startVelLoop()
    else
        stopVelLoop()
        
        -- I-tween pabalik sa huling posisyon bago i-on
        local tweenBack = createTween(CFrame.new(lastPos))
        if tweenBack then
            tweenBack:Play()
            tweenBack.Completed:Wait()
        end
        
        workspace.FallenPartsDestroyHeight = -500 -- Ibalik sa normal kapag naka-OFF
        resetCameraSubject()
        
        if workspace:FindFirstChild("Gaze") then
            workspace.Gaze:Destroy()
        end
    end
end)

