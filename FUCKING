    local lastNilCheck = 0
    while task.wait(0.5) do
        if autoSellEnabled then
            pcall(function()
                local petsFolder = LocalPlayer:FindFirstChild("petsFolder")
                if petsFolder then f9(petsFolder, false) end
                
                for _, folderName in ipairs({"aurasFolder", "boostsFolder", "powerUpsFolder", "auraFolder"}) do
                    local folder = LocalPlayer:FindFirstChild(folderName)
                    if folder then f9(folder, true) end
                end

                local currentTime = tick()
                if getnilinstances and currentTime - lastNilCheck >= 10 then
                    lastNilCheck = currentTime
                    for _, inst in pairs(getnilinstances()) do
                        if inst.ClassName == "ParticleEmitter" or inst.Name:find("Aura") or inst.Name:find("Dark Nebula") then
                            sellPowerUpEvent:FireServer("sellPowerUp", inst)
                            task.wait(0.03)
                        end
                    end
                end
            end)
        end
    end
end)

